<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Bannerlord adapter. Compiles against metadata-only reference assemblies; runs inside the game (net472). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>BannerlordAI.Module</RootNamespace>
    <AssemblyName>BannerlordAICommander</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Copy NuGet runtime dependencies (Anthropic SDK, System.Text.Json, ...) next to our DLL. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ModuleId>BannerlordAICommander</ModuleId>
    <ModuleOutput>$(MSBuildThisFileDirectory)..\..\artifacts\Modules\$(ModuleId)</ModuleOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game + MCM are provided at runtime by the game and the MCM module: compile against them, never ship them. -->
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="1.4.8.119303" PrivateAssets="all" IncludeAssets="compile; build" />
    <PackageReference Include="Bannerlord.MCM" Version="5.13.1" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BannerlordAI.Core\BannerlordAI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Module\SubModule.xml" Link="_Module\SubModule.xml" />
  </ItemGroup>

  <!-- Lay out a ready-to-copy module folder: artifacts/Modules/BannerlordAICommander/{SubModule.xml, bin/Win64_Shipping_Client/*.dll} -->
  <Target Name="PackageModule" AfterTargets="Build">
    <ItemGroup>
      <ModuleDlls Include="$(OutDir)*.dll" Exclude="$(OutDir)TaleWorlds.*.dll;$(OutDir)MCM*.dll;$(OutDir)0Harmony.dll;$(OutDir)Bannerlord.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="..\Module\SubModule.xml" DestinationFolder="$(ModuleOutput)" />
    <Copy SourceFiles="@(ModuleDlls)" DestinationFolder="$(ModuleOutput)\bin\Win64_Shipping_Client" />
    <Message Importance="high" Text="Module packaged to $(ModuleOutput)" />
  </Target>

</Project>
